{
  // Shared Renovate base for yama6a repos. Extend it with "github>yama6a/gha:default.json5".
  // The filename is spelled out because the bare "github>yama6a/gha" form only ever looks for
  // default.json, and a .json file carrying comments is deprecated.
  // Repo-specific rules go in the repo's own renovate.json5: extends resolves first, so a local
  // packageRule appended after this one wins on any key it sets.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard", // one issue listing every pending/failed update (needs repo Issues enabled)
    "helpers:pinGitHubActionDigestsToSemver" // action pins carry a readable version alongside the digest
  ],
  "prConcurrentLimit": 12,
  "prHourlyLimit": 0, // no hourly throttle
  "dependencyDashboardTitle": "Renovate dependency dashboard",

  // GitHub's native auto-merge, armed when the PR is opened. GitHub merges once the required checks
  // are green, so one nightly run is enough. Every repo has required checks (scripts/repo-settings.sh);
  // without them GitHub would merge a PR whose tests failed.
  "platformAutomerge": true,

  "packageRules": [
    {
      "description": "combine all non-major updates into one auto-merged PR",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "lockFileMaintenance"],
      "groupName": "all non-major dependencies",
      "automerge": true
    },
    {
      // The label is what renovate.yaml's BC check picks up; a SAFE verdict arms auto-merge there.
      "description": "majors: their own PR, labelled for the BC check, never automerged",
      "matchUpdateTypes": ["major"],
      "addLabels": ["dep-major"],
      "automerge": false
    },
    {
      // So a moving tag cannot swap an action's code under us.
      "description": "pin github action refs to digests",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      // Rolling base image tags move their contents underneath, so a digest is the only thing Renovate
      // can track. Inert in a repo with no Dockerfile, so it lives here rather than in a language preset.
      "description": "pin base images to digests",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    }
  ]
}
