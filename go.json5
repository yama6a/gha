{
  // Go repos. Extend it with "github>yama6a/gha:go.json5", alongside the default preset.
  // gomodTidy: a bump can leave transitive requirements stale in go.mod.
  // gomodUpdateImportPaths: a Go major lives at a new import path (backoff/v4 -> backoff/v5), and
  // nothing else rewrites the importing source.
  // constraintsFiltering: without it a bump can land a release that needs a newer go directive
  // than the repo declares.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "constraintsFiltering": "strict",
  "packageRules": [
    {
      "description": "let Renovate bump the go directive, which it does not do by default",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    }
  ]
}
