{
  // Go repos. Extend it with "github>yama6a/gha:go.json5", alongside the default preset.
  // gomodTidy: a bump can leave transitive requirements stale in go.mod.
  // gomodUpdateImportPaths: a Go major lives at a new import path (backoff/v4 -> backoff/v5), and
  // nothing else rewrites the importing source.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "let Renovate bump the go directive, which it does not do by default",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      // The gomod manager disables these by default, so a vuln in a transitive dep has no fix path.
      "description": "update indirect go deps too, like `go get -u -t ./...` does",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      // A Go major is a new import path. Only the direct importer can move to it, so a major on an
      // indirect dep is undone by go mod tidy and Renovate ships its own go.mod edit untidied.
      "description": "no majors on indirect go deps",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      // openapi v1.26.0 moved to go.yaml.in/yaml/v3, but oapi-codegen v2.8.0 still passes it
      // gopkg.in/yaml.v3 nodes, so `go generate` stops compiling. Lift once an oapi-codegen release builds with it.
      "description": "hold speakeasy-api/openapi below v1.26.0 until oapi-codegen supports it",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/speakeasy-api/openapi"],
      "allowedVersions": "<1.26.0"
    },
    {
      // jsonpath v0.7.0 requires an openapi pre-release past v1.25.6 that already uses the new YAML package.
      // Lift together with the openapi hold above.
      "description": "hold speakeasy-api/jsonpath below v0.7.0, or it drags openapi past the hold above",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/speakeasy-api/jsonpath"],
      "allowedVersions": "<0.7.0"
    }
  ]
}
