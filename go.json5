{
  // Go repos. Extend it with "github>yama6a/gha:go.json5", alongside the default preset.
  // gomodTidy: a bump can leave transitive requirements stale in go.mod.
  // gomodUpdateImportPaths: a Go major lives at a new import path (backoff/v4 -> backoff/v5), and
  // nothing else rewrites the importing source.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "let Renovate bump the go directive, which it does not do by default",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      // The gomod manager disables these by default, so a vuln in a transitive dep has no fix path.
      "description": "update indirect go deps too, like `go get -u -t ./...` does",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      // A Go major is a new import path. Only the direct importer can move to it, so a major on an
      // indirect dep is undone by go mod tidy and Renovate ships its own go.mod edit untidied.
      "description": "no majors on indirect go deps",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
