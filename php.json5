{
  // Composer repos. Extend it with "github>yama6a/gha:php.json5", alongside the default preset.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      // The floor is the oldest PHP version with security support on php.net. Renovate cannot read that date.
      "description": "the php constraint in composer.json is set by hand",
      "matchManagers": ["composer"],
      "matchPackageNames": ["php"],
      "enabled": false
    }
  ]
}
