{
  // This repo hosts the shared presets and extends its own default. Renovate fetches the preset over
  // the API from the default branch, so it resolves independently of the checkout.
  // Which manager owns what:
  //   github-actions  the action pins in .github/workflows/*.yaml and .github/actions/*/action.yaml
  //   regex           the renovate npm pin behind validate-renovate-config, and the Copilot CLI
  //                   npm pin behind renovate-bc-check
  // Cadence is the cron in .github/workflows/renovate.yaml, not an internal `schedule`, so a manual
  // workflow_dispatch works too.
  //
  // WARNING: an automerged bump here reaches every consuming repo as soon as move-v2.yaml moves the
  // tag, which is on every push to main.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>yama6a/gha:default.json5"],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [".github/actions/validate-renovate-config/action.yaml"],
      matchStrings: ["RENOVATE_VERSION: (?<currentValue>\\S+)"],
      depNameTemplate: "renovate",
      datasourceTemplate: "npm",
    },
    {
      customType: "regex",
      managerFilePatterns: [".github/actions/renovate-bc-check/action.yaml"],
      matchStrings: ["COPILOT_VERSION: (?<currentValue>\\S+)"],
      depNameTemplate: "@github/copilot",
      datasourceTemplate: "npm",
    },
  ],
}
